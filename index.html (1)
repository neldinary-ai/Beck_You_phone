function escapeHtml(str) {
  return String(str).replace(/[&<>"']/g, ch => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  }[ch]));
}

function initialsFor(name) {
  const parts = name.replace(/[“”]/g, "").split(/\s+/).filter(Boolean);
  return parts.slice(0, 2).map(p => p[0]).join("").toUpperCase();
}

function renderPeople() {
  const grid = $("#peopleGrid");
  if (!grid) return;
  grid.innerHTML = PEOPLE.map(p => `
    <button class="person" data-person="${p.id}" aria-label="Open dossier for ${escapeHtml(p.name)}">
      <span class="person__avatar" style="background:${p.color}">${escapeHtml(p.initials || initialsFor(p.name))}</span>
      <span class="person__role">${escapeHtml(p.role)}</span>
      <span class="person__name">${escapeHtml(p.name)}</span>
      <span class="person__line">${escapeHtml(p.line)}</span>
      <span class="person__arrow">Open dossier →</span>
    </button>`).join("");
  $("#peopleCount").textContent = PEOPLE.length + " dossiers";
}

function renderTimeline() {
  const list = $("#timelineList");
  if (!list) return;
  list.innerHTML = TIMELINE.map((e, i) => `
    <article class="event" data-event="${i}">
      <span class="event__dot">${e.n}</span>
      <button class="event__head" aria-expanded="false" aria-controls="event-body-${i}">
        <span class="event__top">
          <span class="event__title">${escapeHtml(e.title)}</span>
          <span class="event__when">${escapeHtml(e.when)}</span>
        </span>
      </button>
      <div class="event__body" id="event-body-${i}">
        <p>${escapeHtml(e.body)}</p>
        <span class="event__tag">novel canon</span>
      </div>
    </article>`).join("");

  $$(".event__head", list).forEach(btn => {
    btn.addEventListener("click", () => {
      const event = btn.closest(".event");
      const open = event.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", String(open));
    });
  });
}

function renderPlaces() {
  const grid = $("#placesGrid");
  if (!grid) return;
  grid.innerHTML = PLACES.map(p => `
    <article class="card place">
      <div class="place__type">${escapeHtml(p.type)}</div>
      <h3>${escapeHtml(p.title)}</h3>
      <p>${escapeHtml(p.body)}</p>
      <div class="place__note">${escapeHtml(p.note)}</div>
    </article>`).join("");
}

function renderEvidence() {
  const grid = $("#evidenceGrid");
  if (!grid) return;
  const icon = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6 7l1 14h10l1-14"/></svg>';
  grid.innerHTML = EVIDENCE.map(e => `
    <article class="card evidence">
      <div class="evidence__icon">${icon}</div>
      <h3>${escapeHtml(e.title)}</h3>
      <p>${escapeHtml(e.body)}</p>
      <div class="evidence__label">${escapeHtml(e.label)}</div>
    </article>`).join("");
}

function renderThemes() {
  const grid = $("#themesGrid");
  if (!grid) return;
  grid.innerHTML = THEMES.map(t => `
    <article class="card theme">
      <div class="theme__n">${t.n}</div>
      <h3>${escapeHtml(t.title)}</h3>
      <p>${escapeHtml(t.body)}</p>
    </article>`).join("");
}

function renderQuotes() {
  const list = $("#quotesList");
  if (!list) return;
  list.innerHTML = QUOTES.map(q => `
    <article class="quote">
      <blockquote>${escapeHtml(q.text)}</blockquote>
      <cite>${escapeHtml(q.cite)}</cite>
      <p class="quote__note">${escapeHtml(q.note)}</p>
    </article>`).join("");
}

/* ============================================================
   NAVIGATION
   ============================================================ */
function showPanel(id, updateHash = true) {
  const panel = document.getElementById(id);
  if (!panel) return;
  $$(".panel").forEach(p => p.classList.toggle("is-active", p.id === id));
  $$(".nav__btn").forEach(b => b.classList.toggle("is-active", b.dataset.panel === id));
  if (updateHash) {
    try { history.replaceState(null, "", "#" + id); } catch (err) {}
  }
  window.scrollTo({ top: 0, behavior: "smooth" });
}

/* ============================================================
   PERSON MODAL
   ============================================================ */
function openPerson(id) {
  const p = PEOPLE.find(x => x.id === id);
  if (!p) return;
  const root = $("#modalRoot");
  root.innerHTML = `
    <div class="modal" role="dialog" aria-modal="true" aria-label="${escapeHtml(p.name)} dossier">
      <div class="modal__panel">
        <div class="modal__top">
          <div>
            <div class="modal__avatar" style="background:${p.color}">${escapeHtml(p.initials || initialsFor(p.name))}</div>
            <div class="modal__eyebrow">Character dossier</div>
            <h2>${escapeHtml(p.name)}</h2>
            <p class="modal__role">${escapeHtml(p.role)}</p>
          </div>
          <button class="modal__close" id="modalClose" aria-label="Close dossier">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="modal__section">
          <h4>Canon facts</h4>
          <ul>${p.facts.map(f => `<li>${escapeHtml(f)}</li>`).join("")}</ul>
        </div>

        <div class="modal__section">
          <h4>Relationships</h4>
          <ul>${p.relationships.map(r => `<li>${escapeHtml(r)}</li>`).join("")}</ul>
        </div>

        <div class="modal__section">
          <h4>Fate</h4>
          <div class="modal__fate">${escapeHtml(p.fate)}</div>
        </div>

        <div class="modal__section">
          <h4>Canon note</h4>
          <p class="modal__note">${escapeHtml(p.note)}</p>
        </div>
      </div>
    </div>`;

  const close = () => { root.innerHTML = ""; };
  $("#modalClose", root).addEventListener("click", close);
  $(".modal", root).addEventListener("click", ev => {
    if (ev.target === ev.currentTarget) close();
  });
  document.addEventListener("keydown", function esc(ev) {
    if (ev.key === "Escape") { close(); document.removeEventListener("keydown", esc); }
  });
  $("#modalClose", root).focus({ preventScroll: true });
}

/* ============================================================
   SEARCH
   ============================================================ */
function bindPeopleSearch() {
  const input = $("#peopleSearch");
  if (!input) return;
  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    const cards = $$(".person");
    let visible = 0;
    cards.forEach(card => {
      const p = PEOPLE.find(x => x.id === card.dataset.person);
      const haystack = [p.name, p.role, p.line, ...p.facts, ...p.relationships].join(" ").toLowerCase();
      const show = !q || haystack.includes(q);
      card.hidden = !show;
      if (show) visible += 1;
    });
    $("#peopleCount").textContent = visible + " dossier" + (visible === 1 ? "" : "s");
    let empty = $("#peopleGrid .empty");
    if (!visible && !empty) {
      empty = document.createElement("div");
      empty.className = "empty";
      empty.textContent = "No dossier matches that search.";
      $("#peopleGrid").appendChild(empty);
    } else if (visible && empty) {
      empty.remove();
    }
  });
}

/* ============================================================
   INIT
   ============================================================ */
function init() {
  renderPeople();
  renderTimeline();
  renderPlaces();
  renderEvidence();
  renderThemes();
  renderQuotes();
  bindPeopleSearch();

  $$(".nav__btn").forEach(btn => {
    btn.addEventListener("click", () => showPanel(btn.dataset.panel));
  });

  document.addEventListener("click", ev => {
    const person = ev.target.closest ? ev.target.closest("[data-person]") : null;
    if (person) openPerson(person.dataset.person);
  });

  const hash = window.location.hash.replace("#", "");
  if (hash && document.getElementById(hash)) {
    showPanel(hash, false);
  }

  window.addEventListener("hashchange", () => {
    const id = window.location.hash.replace("#", "");
    if (id && document.getElementById(id)) showPanel(id, false);
  });
}

init();
</script>
