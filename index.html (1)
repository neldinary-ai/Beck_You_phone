<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#08090b" />
<title>YOU — A Canon Archive · Nada Farag Elsayed Farag</title>
<meta name="description" content="An interactive, canon-faithful study of Caroline Kepnes's novel You (2014). Created by Nada Farag Elsayed Farag." />
<meta name="author" content="Nada Farag Elsayed Farag" />
<style>
:root{
  --bg:#08090b;
  --bg-2:#0d0f13;
  --panel:#111419;
  --panel-2:#161a20;
  --line:rgba(255,255,255,.09);
  --line-strong:rgba(255,255,255,.16);
  --ink:#eee9df;
  --ink-soft:#cfc8bb;
  --muted:#918b80;
  --dim:#625d55;
  --amber:#d8a657;
  --amber-soft:rgba(216,166,87,.12);
  --amber-line:rgba(216,166,87,.34);
  --signal:#7fe0a8;
  --danger:#d87979;
  --blue:#7d9fd4;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
  --max:1360px;
  --radius:18px;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  min-height:100vh;
  color:var(--ink);
  background:
    radial-gradient(70% 55% at 12% -10%, rgba(53,67,90,.32), transparent 62%),
    radial-gradient(60% 50% at 96% 12%, rgba(120,82,35,.16), transparent 62%),
    radial-gradient(80% 80% at 50% 105%, rgba(30,40,55,.22), transparent 60%),
    var(--bg);
  font-family:var(--sans);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
body::before{
  content:"";
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    repeating-linear-gradient(0deg, rgba(255,255,255,.018) 0 1px, transparent 1px 4px);
  opacity:.45;
  mask-image:radial-gradient(80% 70% at 50% 40%, #000 30%, transparent 100%);
}
a{color:inherit;text-decoration:none}
button,input{font:inherit;color:inherit}
button{background:none;border:0;padding:0;cursor:pointer}
img,svg{display:block}
::selection{background:rgba(216,166,87,.28);color:#fff}
[hidden]{display:none !important}

/* ---------- shell ---------- */
.topbar{
  position:sticky;top:0;z-index:40;
  backdrop-filter:blur(20px) saturate(140%);
  -webkit-backdrop-filter:blur(20px) saturate(140%);
  background:rgba(8,9,11,.78);
  border-bottom:1px solid var(--line);
}
.topbar__inner{
  max-width:var(--max);margin:0 auto;
  padding:14px 24px;
  display:flex;align-items:center;justify-content:space-between;gap:18px;
}
.brand{display:flex;align-items:baseline;gap:10px;min-width:0}
.brand__mark{font-family:var(--serif);font-size:23px;letter-spacing:.08em;color:var(--ink)}
.brand__sub{font-family:var(--mono);font-size:7px;letter-spacing:.26em;text-transform:uppercase;color:var(--amber)}
.topbar__credit{
  font-family:var(--mono);font-size:7px;line-height:1.6;letter-spacing:.15em;
  text-transform:uppercase;color:var(--dim);text-align:right;
}
.topbar__credit b{display:block;color:var(--ink-soft);font-weight:500;font-size:8px;letter-spacing:.11em}
.topbar__badge{
  display:inline-flex;align-items:center;gap:6px;
  font-family:var(--mono);font-size:6.5px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--signal);border:1px solid rgba(127,224,168,.25);border-radius:999px;
  padding:4px 7px;background:rgba(127,224,168,.05);white-space:nowrap;
}
.topbar__badge i{width:5px;height:5px;border-radius:50%;background:var(--signal);box-shadow:0 0 8px rgba(127,224,168,.8)}

.layout{
  position:relative;z-index:1;
  max-width:var(--max);margin:0 auto;
  display:grid;grid-template-columns:250px minmax(0,1fr);
  gap:34px;padding:28px 24px 80px;
}
.sidebar{position:sticky;top:92px;align-self:start}
.nav{display:flex;flex-direction:column;gap:3px}
.nav__btn{
  display:flex;align-items:center;gap:11px;
  width:100%;text-align:left;padding:11px 12px;border-radius:10px;
  color:var(--muted);transition:background .18s,color .18s;
  border:1px solid transparent;
}
.nav__btn:hover{background:rgba(255,255,255,.04);color:var(--ink-soft)}
.nav__btn.is-active{background:linear-gradient(90deg,var(--amber-soft),rgba(216,166,87,.02));border-color:var(--amber-line);color:var(--ink)}
.nav__n{font-family:var(--mono);font-size:8px;color:var(--dim);width:18px;flex:0 0 auto}
.nav__btn.is-active .nav__n{color:var(--amber)}
.nav__label{font-size:12px;letter-spacing:.01em}
.sidebar__meta{margin-top:28px;padding-top:18px;border-top:1px solid var(--line)}
.sidebar__meta p{margin:0 0 9px;font-family:var(--mono);font-size:7px;line-height:1.9;letter-spacing:.13em;text-transform:uppercase;color:var(--dim)}
.sidebar__meta b{color:var(--ink-soft);font-weight:500}
.sidebar__rule{width:34px;height:1px;background:var(--amber-line);margin:14px 0}

/* ---------- panels ---------- */
.panel{display:none;animation:panelIn .35s cubic-bezier(.22,.8,.3,1) both}
.panel.is-active{display:block}
@keyframes panelIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.panel__head{margin-bottom:24px}
.kicker{
  display:flex;align-items:center;gap:8px;
  font-family:var(--mono);font-size:7.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--amber);
  margin-bottom:9px;
}
.kicker::before{content:"";width:22px;height:1px;background:var(--amber-line)}
.panel__head h2{
  margin:0;font-family:var(--serif);font-size:38px;line-height:1.08;font-weight:500;letter-spacing:-.02em;
}
.panel__head p{margin:10px 0 0;max-width:680px;font-size:13px;line-height:1.7;color:var(--muted)}

/* ---------- hero ---------- */
.hero{padding:18px 0 8px}
.hero__case{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--mono);font-size:7px;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);
  border:1px solid var(--line-strong);border-radius:999px;padding:6px 10px;
  margin-bottom:24px;
}
.hero__case i{width:5px;height:5px;border-radius:50%;background:var(--amber)}
.hero h1{
  margin:0;
  font-family:var(--serif);font-size:clamp(72px,12vw,148px);line-height:.78;font-weight:400;
  letter-spacing:-.075em;color:#f1ece2;
  text-shadow:0 18px 70px rgba(0,0,0,.55);
}
.hero h1 span{display:block;margin:18px 0 0;font-family:var(--mono);font-size:9px;line-height:1.8;letter-spacing:.34em;text-transform:uppercase;color:var(--amber);text-shadow:none}
.hero__lede{max-width:620px;margin:24px 0 0;font-family:var(--serif);font-size:20px;line-height:1.55;color:var(--ink-soft)}
.hero__meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}
.chip{
  font-family:var(--mono);font-size:7px;letter-spacing:.13em;text-transform:uppercase;
  color:var(--muted);border:1px solid var(--line-strong);border-radius:999px;padding:5px 8px;
}
.chip--amber{color:var(--amber);border-color:var(--amber-line);background:var(--amber-soft)}
.hero__note{
  margin-top:30px;padding:15px 16px;border-left:2px solid var(--amber);
  background:linear-gradient(90deg,rgba(216,166,87,.09),rgba(216,166,87,.015));
  font-size:12px;line-height:1.7;color:#c9bda8;
}
.hero__note b{color:var(--amber);font-weight:600}
.hero__credit{
  margin-top:26px;font-family:var(--mono);font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);
}
.hero__credit b{color:var(--ink-soft);font-weight:500}

/* ---------- overview cards ---------- */
.grid{display:grid;gap:12px}
.grid--3{grid-template-columns:repeat(3,minmax(0,1fr))}
.grid--2{grid-template-columns:repeat(2,minmax(0,1fr))}
.card{
  position:relative;padding:18px;border:1px solid var(--line);border-radius:var(--radius);
  background:linear-gradient(155deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
  overflow:hidden;
}
.card::after{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:linear-gradient(160deg,rgba(255,255,255,.06),transparent 38%);
}
.card__n{font-family:var(--mono);font-size:7px;letter-spacing:.18em;color:var(--amber);margin-bottom:12px}
.card h3{margin:0;font-family:var(--serif);font-size:19px;font-weight:500;line-height:1.2}
.card p{margin:8px 0 0;font-size:11.5px;line-height:1.65;color:var(--muted)}
.card--rule{display:flex;flex-direction:column;justify-content:space-between;min-height:155px}
.card--rule .rule{width:100%;height:1px;background:var(--line);margin:16px 0 12px}

/* ---------- people ---------- */
.people-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.search{
  flex:1;min-width:220px;display:flex;align-items:center;gap:8px;
  border:1px solid var(--line-strong);border-radius:11px;background:rgba(255,255,255,.025);
  padding:10px 12px;
}
.search svg{color:var(--dim);flex:0 0 auto}
.search input{width:100%;background:none;border:0;outline:none;font-size:12px;color:var(--ink)}
.search input::placeholder{color:var(--dim)}
.search:focus-within{border-color:var(--amber-line);box-shadow:0 0 0 3px rgba(216,166,87,.06)}
.people-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.person{
  display:flex;flex-direction:column;align-items:flex-start;text-align:left;
  padding:18px;border:1px solid var(--line);border-radius:var(--radius);
  background:linear-gradient(155deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
  transition:transform .2s,border-color .2s,background .2s;min-height:190px;
}
.person:hover,.person:focus-visible{transform:translateY(-2px);border-color:var(--amber-line);background:linear-gradient(155deg,rgba(216,166,87,.08),rgba(255,255,255,.015));outline:none}
.person__avatar{
  width:44px;height:44px;border-radius:50%;display:grid;place-items:center;
  font-family:var(--serif);font-size:16px;color:#f0e9dd;
  border:1px solid rgba(255,255,255,.15);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.16);
  margin-bottom:14px;
}
.person__role{font-family:var(--mono);font-size:6.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--amber);margin-bottom:5px}
.person__name{font-family:var(--serif);font-size:20px;line-height:1.1;margin:0}
.person__line{font-size:11px;line-height:1.6;color:var(--muted);margin-top:7px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.person__arrow{margin-top:auto;padding-top:14px;font-family:var(--mono);font-size:6.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
.empty{grid-column:1/-1;padding:36px 18px;text-align:center;font-family:var(--serif);font-style:italic;color:var(--muted);border:1px dashed var(--line-strong);border-radius:var(--radius)}

/* ---------- timeline ---------- */
.timeline{position:relative;margin-top:8px}
.timeline::before{content:"";position:absolute;left:29px;top:10px;bottom:10px;width:1px;background:linear-gradient(180deg,var(--amber-line),rgba(255,255,255,.06))}
.event{position:relative;padding:0 0 8px 62px}
.event__dot{
  position:absolute;left:21px;top:19px;width:17px;height:17px;border-radius:50%;
  border:1px solid var(--amber-line);background:var(--bg);display:grid;place-items:center;
  font-family:var(--mono);font-size:6px;color:var(--amber);
}
.event__head{
  width:100%;text-align:left;padding:13px 14px;border:1px solid var(--line);border-radius:12px;
  background:rgba(255,255,255,.025);transition:background .18s,border-color .18s;
}
.event__head:hover{background:rgba(255,255,255,.045);border-color:var(--line-strong)}
.event__head:focus-visible{outline:1px solid var(--amber);outline-offset:2px}
.event__top{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.event__title{font-family:var(--serif);font-size:17px;line-height:1.25;color:var(--ink)}
.event__when{font-family:var(--mono);font-size:6.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--dim);white-space:nowrap}
.event__body{padding:12px 14px 6px;font-size:12px;line-height:1.75;color:var(--muted);display:none}
.event__body p{margin:0 0 8px}
.event.is-open .event__body{display:block;animation:panelIn .25s ease both}
.event.is-open .event__head{border-color:var(--amber-line);background:rgba(216,166,87,.05)}
.event__tag{display:inline-flex;margin-top:4px;font-family:var(--mono);font-size:6px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);border:1px solid var(--amber-line);border-radius:3px;padding:2px 5px}
.timeline-note{margin:18px 0 0 62px;font-family:var(--mono);font-size:7px;line-height:1.9;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}

/* ---------- places / evidence ---------- */
.place__type{font-family:var(--mono);font-size:6.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);margin-bottom:7px}
.place h3{font-size:20px}
.place p{font-size:11.5px}
.place__note{margin-top:12px;padding-top:10px;border-top:1px solid var(--line);font-family:var(--mono);font-size:6.5px;line-height:1.8;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.evidence__icon{
  width:36px;height:36px;border-radius:10px;display:grid;place-items:center;
  border:1px solid var(--line-strong);background:rgba(216,166,87,.06);color:var(--amber);
  margin-bottom:12px;
}
.evidence h3{font-size:18px}
.evidence__label{font-family:var(--mono);font-size:6px;letter-spacing:.15em;text-transform:uppercase;color:var(--dim);margin-top:11px}

/* ---------- themes ---------- */
.theme{padding:20px}
.theme__n{font-family:var(--serif);font-size:34px;line-height:1;color:rgba(216,166,87,.5);margin-bottom:14px}
.theme h3{font-size:20px}
.theme p{font-size:12px;line-height:1.7}

/* ---------- quotes ---------- */
.quotes{display:grid;gap:14px;max-width:900px}
.quote{
  padding:24px 24px 20px;border:1px solid var(--line);border-radius:var(--radius);
  background:linear-gradient(155deg,rgba(216,166,87,.065),rgba(255,255,255,.012));
  position:relative;overflow:hidden;
}
.quote::before{content:"“";position:absolute;left:14px;top:-18px;font-family:var(--serif);font-size:100px;line-height:1;color:rgba(216,166,87,.12)}
.quote blockquote{margin:0;font-family:var(--serif);font-size:22px;line-height:1.5;color:var(--ink-soft);position:relative}
.quote cite{display:block;margin-top:16px;font-family:var(--mono);font-size:7px;font-style:normal;letter-spacing:.15em;text-transform:uppercase;color:var(--amber)}
.quote__note{margin:8px 0 0;font-size:11px;line-height:1.6;color:var(--dim)}

/* ---------- about ---------- */
.about{max-width:900px}
.about__name{
  font-family:var(--serif);font-size:34px;line-height:1.2;margin:0 0 6px;color:var(--ink);
}
.about__role{font-family:var(--mono);font-size:7px;letter-spacing:.2em;text-transform:uppercase;color:var(--amber);margin:0 0 24px}
.about__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:22px}
.about p{font-size:12px;line-height:1.75;color:var(--muted)}
.about h3{margin:0 0 8px;font-size:12px;font-family:var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.about ul{margin:0;padding-left:17px}
.about li{font-size:11.5px;line-height:1.7;color:var(--muted);margin-bottom:6px}
.source-list{display:flex;flex-direction:column;gap:7px;margin-top:10px}
.source-list span{font-family:var(--mono);font-size:7px;line-height:1.7;letter-spacing:.08em;color:var(--dim)}

/* ---------- footer ---------- */
.footer{
  position:relative;z-index:1;max-width:var(--max);margin:0 auto;
  padding:24px 24px 34px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;
  font-family:var(--mono);font-size:7px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);
}
.footer b{color:var(--ink-soft);font-weight:500}

/* ---------- modal ---------- */
.modal-root{position:fixed;inset:0;z-index:80;pointer-events:none}
.modal{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:center;pointer-events:auto;background:rgba(4,5,7,.72);backdrop-filter:blur(10px);animation:fadeIn .2s ease both;padding:20px}
.modal__panel{
  width:min(760px,100%);max-height:min(82vh,760px);overflow:auto;
  background:linear-gradient(160deg,#15191f,#0d1014);border:1px solid var(--line-strong);
  border-radius:22px;padding:24px;box-shadow:0 30px 90px -20px #000;animation:modalIn .3s cubic-bezier(.2,.8,.3,1) both;
  scrollbar-width:none;
}
.modal__panel::-webkit-scrollbar{display:none}
@keyframes modalIn{from{opacity:0;transform:translateY(18px) scale(.99)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal__top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.modal__close{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.07);color:var(--ink-soft);flex:0 0 auto}
.modal__close:hover{background:rgba(255,255,255,.13);color:#fff}
.modal__avatar{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;font-family:var(--serif);font-size:20px;border:1px solid rgba(255,255,255,.16);margin-bottom:14px}
.modal__eyebrow{font-family:var(--mono);font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:var(--amber);margin-bottom:5px}
.modal h2{margin:0;font-family:var(--serif);font-size:36px;line-height:1.08;font-weight:500}
.modal__role{font-size:12px;color:var(--muted);margin:8px 0 20px}
.modal__section{border-top:1px solid var(--line);padding-top:14px;margin-top:14px}
.modal__section h4{margin:0 0 8px;font-family:var(--mono);font-size:7px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber)}
.modal__section ul{margin:0;padding-left:16px}
.modal__section li{font-size:12px;line-height:1.65;color:var(--ink-soft);margin-bottom:6px}
.modal__fate{font-size:12px;line-height:1.7;color:#d9b0a8;background:rgba(216,121,121,.06);border:1px solid rgba(216,121,121,.2);border-radius:10px;padding:11px 12px}
.modal__note{font-size:10.5px;line-height:1.7;color:var(--dim);font-style:italic;margin-top:14px}

/* ---------- responsive ---------- */
@media (max-width:1050px){
  .layout{grid-template-columns:210px minmax(0,1fr);gap:24px}
  .people-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid--3{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:760px){
  .topbar__inner{padding:11px 16px;align-items:flex-start}
  .brand__sub{display:none}
  .topbar__credit{font-size:6px}
  .topbar__badge{display:none}
  .layout{display:block;padding:18px 16px 60px}
  .sidebar{position:static;margin-bottom:22px}
  .nav{flex-direction:row;overflow-x:auto;gap:4px;padding-bottom:4px;scrollbar-width:none}
  .nav::-webkit-scrollbar{display:none}
  .nav__btn{flex:0 0 auto;width:auto;padding:7px 9px;border:1px solid var(--line);background:rgba(255,255,255,.025)}
  .nav__n{display:none}
  .nav__label{font-size:10px;white-space:nowrap}
  .sidebar__meta{display:none}
  .panel__head h2{font-size:31px}
  .hero h1{font-size:clamp(62px,20vw,100px)}
  .hero__lede{font-size:17px}
  .people-grid,.grid--3,.grid--2,.about__grid{grid-template-columns:1fr}
  .timeline::before{left:19px}
  .event{padding-left:46px}
  .event__dot{left:11px}
  .event__top{display:block}
  .event__when{display:block;margin-top:4px}
  .timeline-note{margin-left:46px}
  .modal{padding:10px}
  .modal__panel{padding:20px;border-radius:18px}
  .modal h2{font-size:29px}
  .footer{padding:20px 16px 30px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important;scroll-behavior:auto !important}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="topbar__inner">
    <a class="brand" href="#overview" aria-label="YOU Canon Archive, overview">
      <span class="brand__mark">YOU</span>
      <span class="brand__sub">Canon Archive</span>
    </a>
    <div class="topbar__credit">
      Created by <b>Nada Farag Elsayed Farag</b>
      <span class="topbar__badge"><i></i> Novel canon only</span>
    </div>
  </div>
</header>

<div class="layout">
  <aside class="sidebar" aria-label="Archive sections">
    <nav class="nav" id="nav">
